@article{garlickHowLobbyingMatters2025,
  title = {How {{Lobbying Matters}}},
  author = {Garlick, Alex and Junk, Wiebke Marie and Brown, Heath},
  year = 2025,
  month = jun,
  journal = {Annual Review of Political Science},
  volume = {28},
  number = {Volume 28, 2025},
  pages = {457--475},
  publisher = {Annual Reviews},
  issn = {1094-2939, 1545-1577},
  doi = {10.1146/annurev-polisci-033123-124920},
  urldate = {2025-07-29},
  abstract = {For decades, political scientists have struggled to provide empirical evidence that lobbying influences policymaking. A considerable gap arose between widespread public suspicions of lobbying and the literature\&apos;s findings, which failed to document systematic lobbying influence in politics. This gap has closed within the last decade. Causal inference strategies, high-quality data sets, and attention to lobbying in multiple venues have allowed researchers to document the ways in which lobbying matters. In this review, we summarize three ways lobbying has an effect, as documented in this new literature. First, in line with public suspicions, lobbyists have transactional relationships with public officials in which they exchange money for political access and influence. Second, lobbyists persuade public officials by providing information that changes the positions taken by policymakers. Third, successful mobilization of citizen support or lobbying coalitions helps lobbyists attain policy aims. Jointly, these influence pathways nuance our view of lobbying as both harmful and beneficial for democratic representation.},
  langid = {english},
  file = {C:\Users\dweis\Zotero\storage\TSWSWHNZ\Garlick et al. - 2025 - How Lobbying Matters.pdf}
}

