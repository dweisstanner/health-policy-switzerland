@article{sagerFixingFederalFaults2019,
  title = {Fixing {{Federal Faults}}. {{Complementary Member State Policies}} in {{Swiss Health Care Policy}}},
  author = {Sager, Fritz and R{\"u}efli, Christian and Thomann, Eva},
  year = 2019,
  month = oct,
  journal = {International Review of Public Policy},
  volume = {1},
  number = {2},
  pages = {147--172},
  publisher = {International Public Policy Association},
  issn = {2679-3873},
  doi = {10.4000/irpp.426},
  urldate = {2024-10-14},
  abstract = {This article aims to understand what makes member states complement federal healthcare policy beyond the instruments planned by federal policy. We employ a Multiple Streams approach to study how Swiss member states use their discretion in order to complement federal healthcare regulation with the aim of decreasing outpatient healthcare expenditures at the cantonal level. Based on a written survey in the Swiss cantons, we perform a Fuzzy Set Qualitative Comparative Analysis (fsQCA), which places a keen emphasis on complex patterns. The method identifies what combinations of determinants make it particularly likely that a canton opts for complementary policy activity. Several configurations prove to foster such activity. While this is important, it is also important to pay attention to the constellations that precisely do not foster complementary policy activity. Our analysis of the cantonal choices on governing outpatient healthcare reveals that party politics in the executive and/or the public administration play a major role in this task, whereas neither organized interests within the medical profession nor individual policy entrepreneurs are crucial. Federalist systems offer opportunities for policy innovations the federal level ultimately may benefit from.},
  copyright = {https://creativecommons.org/licenses/by/4.0/},
  langid = {english},
  keywords = {complementary cantonal policy making,federalism,Fuzzy Set Qualitative Comparative Analysis (fsQCA),health policy,implementation,member states,Multiple Streams Framework (MSF),outpatient healthcare,Switzerland,vertical federal relations},
  file = {C:\Users\dweis\Zotero\storage\CS4RERM3\Sager et al. - 2019 - Fixing Federal Faults. Complementary Member State Policies in Swiss Health Care Policy.pdf}
}

@misc{santesuisseMedikamenteTiefereMedikamentenpreise2024,
  title = {{Medikamente: Tiefere Medikamentenpreise sind l\"angst f\"allig}},
  shorttitle = {{Medikamente}},
  author = {{sant{\'e}suisse}},
  year = 2024,
  month = oct,
  urldate = {2025-07-17},
  abstract = {Die Schweizer Bev\"olkerung gibt pro Kopf nach den USA weltweit am meisten Geld f\"ur Medikamente aus. In der obligatorischen Krankenpflegeversicherung (OKP) sind die Medikamentenausgaben der dritth\"ochste Kostenblock -- nach den ambulanten und station\"aren Behandlungen. Die patentgesch\"utzten Medikamente sind im europ\"aischen Ausland durchschnittlich 9 Prozent g\"unstiger. Die Generika kosten in der Schweiz im Durchschnitt sogar fast doppelt so viel. Zudem ist der Anteil an verschriebenen Generika gegen\"uber den Nachbarl\"andern sehr tief. Das heutige Anreizsystem verhindert, dass mehr und g\"unstigere Generika verschrieben werden. Preismodelle bei neuen Arzneimitteln und die Einzelfallverg\"utung sind mittlerweile mit hohen administrativen Kosten bei den Krankenversicherern verbunden.},
  howpublished = {https://www.santesuisse.ch/de/newsdetail/news/medikamente-tiefere-medikamentenpreise-sind-laengst-faellig/},
  langid = {ngerman},
  file = {C:\Users\dweis\Zotero\storage\523BCFFL\medikamente-tiefere-medikamentenpreise-sind-laengst-faellig.html}
}

