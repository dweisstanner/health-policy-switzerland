@article{asticherCaringCOVIDSwiss2026,
  title = {Caring after {{COVID}}: Swiss Health Policy, Windows of Opportunity, and Programmatic Groups},
  shorttitle = {Caring after {{COVID}}},
  author = {Asticher, Lisa and Hornung, Johanna},
  year = 2026,
  month = apr,
  journal = {Journal of Public Policy},
  pages = {1--20},
  issn = {0143-814X, 1469-7815},
  doi = {10.1017/S0143814X25100974},
  urldate = {2026-04-19},
  abstract = {The COVID-19 pandemic presented a window of opportunity for policy change, but was not exploited as such everywhere. Surprisingly, in Switzerland, usually characterized by a stable political landscape and incremental policy changes, an unexpected reform, the Nursing Initiative, was adopted. This paper examines the underlying mechanisms driving this adoption, employing a cross-fertilization of the multiple streams framework with the programmatic action framework and relying on expert interviews. The analysis shows that partial streams coupling began years before the pandemic, facilitated by the strengthening of nursing care professions' identity into a programmatic group. Switzerland's direct democracy enabled the opening of an agenda window, allowing the programmatic group to effectively couple their policy with political dynamics in the policy process. Finally, the COVID-19 crisis acted as a decision window, opening from the problem stream and providing momentum for policy action and decision-making.},
  langid = {english},
  keywords = {(MSF),policy entrepreneurs,programmatic action framework (PAF),stream coupling},
  file = {C:\Users\dweis\Zotero\storage\I9D5JJ3N\Asticher and Hornung - 2026 - Caring after COVID swiss health policy, windows of opportunity, and programmatic groups.pdf}
}

